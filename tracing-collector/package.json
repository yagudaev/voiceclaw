{
  "name": "voiceclaw-tracing-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OTLP-HTTP receiver that writes VoiceClaw traces to a local SQLite DB for the tracing UI.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "dependencies": {
    "@opentelemetry/otlp-transformer": "^0.215.0",
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
